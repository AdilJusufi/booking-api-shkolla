{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "emitDeclarationOnly": true,
    "outDir": "./dist-tsnode"
  },
  // runtimeCaching.ts is shared: the app project type-checks it (and its test),
  // while the build config imports it so the Workbox rules have one source of truth.
  "include": ["vite.config.ts", "src/pwa/runtimeCaching.ts"]
}
