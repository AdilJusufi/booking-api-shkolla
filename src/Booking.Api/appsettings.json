{
  "ConnectionStrings": {
    "BookingDb": ""
  },
  "Jwt": {
    "Issuer": "booking-api",
    "Audience": "booking-api-clients",
    "Secret": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Auth": {
    "RequireConfirmedEmail": true
  },
  "Booking": {
    "CancellationCutoffHours": 12
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Seed": {
    "Enabled": false,
    "SuperAdminPassword": "",
    "DefaultUserPassword": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "ForwardedHeaders": {
    "Enabled": true
  },
  "Frontend": {
    "BaseUrl": ""
  },
  "Cloudinary": {
    "CloudName": "",
    "ApiKey": "",
    "ApiSecret": ""
  },
  "Resend": {
    "ApiKey": "",
    "FromAddress": ""
  },
  "EmailAbuseLimits": {
    "PerAddressCooldownMinutes": 2,
    "PerAddressDailyLimit": 5,
    "PurposeWindowHours": 24,
    "PurposeWindowLimits": {
      "PasswordReset": 25,
      "EmailConfirmation": 15
    },
    "DefaultPurposeWindowLimit": 10
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*"
}
